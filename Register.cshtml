@model RaceDayMVC1.Models.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Register";
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow border-0">
                <div class="card-body p-4">

                    <h2 class="text-center mb-2">Create Account</h2>
                    <p class="text-center text-muted mb-4">
                        Join the RaceDay community!
                    </p>

                    <form asp-action="Register" method="post">
                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="FullName" class="form-label">
                                Full Name
                            </label>
                            <input asp-for="FullName" class="form-control"
                                   placeholder="Enter your full name" />
                            <span asp-validation-for="FullName"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label">
                                Email Address
                            </label>
                            <input asp-for="Email" class="form-control"
                                   placeholder="Enter your email" />
                            <span asp-validation-for="Email"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label">
                                Password
                            </label>
                            <input asp-for="Password" class="form-control"
                                   placeholder="Create a password" />
                            <span asp-validation-for="Password"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ConfirmPassword"
                                   class="form-label">
                                Confirm Password
                            </label>
                            <input asp-for="ConfirmPassword"
                                   class="form-control"
                                   placeholder="Confirm your password" />
                            <span asp-validation-for="ConfirmPassword"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Role" class="form-label">
                                Account Type
                            </label>
                            <select asp-for="Role" class="form-select">
                                <option value="">Select account type</option>
                                <option value="Participant">Participant</option>
                                <option value="Organiser">Organiser</option>
                            </select>
                            <span asp-validation-for="Role"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="PhoneNumber"
                                   class="form-label">
                                Phone Number (Organisers)
                            </label>
                            <input asp-for="PhoneNumber"
                                   class="form-control"
                                   placeholder="Enter phone number" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="DateOfBirth"
                                   class="form-label">
                                Date of Birth (Participants)
                            </label>
                            <input asp-for="DateOfBirth"
                                   type="date"
                                   class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="EmergencyContact"
                                   class="form-label">
                                Emergency Contact (Participants)
                            </label>
                            <input asp-for="EmergencyContact"
                                   class="form-control"
                                   placeholder="Enter emergency contact details" />
                        </div>

                        <button type="submit"
                                class="btn btn-primary w-100">
                            Create Account
                        </button>
                    </form>

                    <hr />

                    <p class="text-center mb-0">
                        Already registered?
                        <a asp-action="Login">Login here</a>
                    </p>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
